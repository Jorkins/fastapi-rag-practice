# ---- 应用 ----
APP_NAME=FastAPI RAG Practice
DEBUG=true

# ---- 数据库（本地默认 SQLite，零依赖；生产换 PostgreSQL + pgvector）----
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/rag
DATABASE_URL=sqlite+aiosqlite:///./rag.db

# ---- Redis / Celery ----
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# true = 本地无 Redis 也能跑（任务同步执行）；生产置 false 并启动 worker
CELERY_TASK_ALWAYS_EAGER=true

# ---- RAG ----
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=4
# mock（零依赖跑通）| openai | ollama
EMBEDDING_PROVIDER=mock
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# ---- 定时任务 ----
ENABLE_SCHEDULER=true
